# StreamPulse Public Viewer Environment Variables
# (Never place ADMIN_PASSWORD or SUPABASE_SERVICE_ROLE_KEY here)

# Streaming Backend / Signaling Server URL (Default: empty for same origin, or e.g. https://api.yourdomain.com)
NEXT_PUBLIC_STREAM_SERVER_URL=

# Optional: Supabase Client Public Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
